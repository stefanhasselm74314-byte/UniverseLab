<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ChatArchivFastScroll">
        <item name="android:fastScrollThumbDrawable">@drawable/chatarchiv_fastscroll_thumb</item>
        <item name="android:fastScrollTrackDrawable">@drawable/chatarchiv_fastscroll_track</item>
    </style>

    <style name="ChatArchivTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#D3D3D3</item>
        <item name="android:colorControlActivated">#D3D3D3</item>
        <item name="android:colorControlNormal">#999999</item>
        <item name="android:colorControlHighlight">#666666</item>
        <item name="android:textColorHighlight">#585858</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#121212</item>
    </style>
</resources>
