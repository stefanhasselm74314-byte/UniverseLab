<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ChatArchivFastScroll">
        <item name="android:fastScrollThumbDrawable">@drawable/chatarchiv_fastscroll_thumb</item>
        <item name="android:fastScrollTrackDrawable">@drawable/chatarchiv_fastscroll_track</item>
    </style>

    <style name="ChatArchivTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">#FAFAFA</item>
        <item name="android:textColorSecondary">#D2D2D2</item>
        <item name="android:textColorHint">#CCCCCC</item>
        <item name="android:colorAccent">#E6E6E6</item>
        <item name="android:colorControlActivated">#E6E6E6</item>
        <item name="android:colorControlNormal">#BEBEBE</item>
        <item name="android:colorControlHighlight">#888888</item>
        <item name="android:textColorHighlight">#777777</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#121212</item>
    </style>
</resources>
