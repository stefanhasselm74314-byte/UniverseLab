{
  "schema": "universelab.public-privacy-contract.v1",
  "contract_id": "UL-PRIVACY-20260803-001",
  "date": "2026-08-03",
  "status": "ACTIVE_GOVERNANCE_CONTRACT",
  "privacy_classification": "PUBLIC_SANITIZED",
  "scope": [
    "public registry files",
    "public governance and prompt files",
    "public scientific text artifacts",
    "public HTML and machine-readable status surfaces",
    "public issue and pull-request summaries"
  ],
  "forbidden_public_metadata": [
    "conversation identifiers",
    "attachment identifiers",
    "ChatGPT share links",
    "raw conversation transcripts",
    "private archive filenames with personal naming",
    "detailed account-export inventories and statistics",
    "private local or cloud paths",
    "email addresses and contact details unless explicitly released",
    "API keys, tokens, passwords and private keys"
  ],
  "allowed_public_provenance": [
    "sanitized source IDs",
    "versioned repository paths",
    "scientifically necessary content hashes",
    "aggregate archive-recovery status",
    "explicit limitations and gate effects"
  ],
  "enforcement": {
    "mode": "READ_ONLY_FAIL_CLOSED",
    "validator": "tools/2026-08-03_validate_public_repository_privacy_v1.0.py",
    "tests": "tests/2026-08-03_test_public_repository_privacy_v1.0.py",
    "workflow": ".github/workflows/research-contracts.yml",
    "failure_effect": "MERGE_BLOCKING_QA_FAILURE"
  },
  "history_policy": {
    "current_tree_remediation": "REQUIRED",
    "git_history_rewrite": "SEPARATE_PROPORTIONALITY_DECISION_REQUIRED",
    "reason": "History rewriting changes commit identities, pull-request references and downstream clones and is not automatic for non-secret metadata."
  },
  "scientific_gate_effect": {
    "K1-D": "UNCHANGED_NOT_RELEASED",
    "K1-E": "UNCHANGED_NOT_ADMISSIBLE",
    "physical_evidence_effect": "NONE"
  }
}
