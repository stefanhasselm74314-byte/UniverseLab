    "published_best_fit_as_label": false,
    "training_source": "PHYSICS_BASED_SIMULATIONS_OR_A_SEPARATELY_VALIDATED_SURROGATE_ONLY",
    "required_independent_partitions": ["TRAIN", "VALIDATION", "CALIBRATION", "FINAL_SIM_TEST", "OOD_STRESS"],
    "split_leakage": "FORBIDDEN",
    "coverage_required": ["68_PERCENT", "95_PERCENT"],
    "baseline_required": "NON_ML_REFERENCE_INFERENCE_OR_SUMMARY_PIPELINE"
  },
  "transfer_and_domain_shift": {
    "required_pre_real_data_checks": [
      "physical-engine cross-check on a declared cosmology grid",
      "observable-vector ordering check",
      "tomography ordering check",
      "units and angular-range check",
      "covariance-normalized residual check",
      "source-nz perturbation stress",
      "intrinsic-alignment stress",
      "baryonic-or-scale-policy stress",
      "shape-noise stress",
      "mask-or-window consistency",
      "simulation-to-reference-distribution shift diagnostic",
      "predeclared OOD abstention threshold"
    ],
    "abstention_rule": "If the real-data feature vector falls outside the validated simulation support under the frozen OOD rule, the ML result must abstain and no cosmological interpretation is allowed."
  },
  "physical_validation_gates": {
    "B0_contract_completeness": "PASS_BY_THIS_STAGE_IF_CI_GREEN",
