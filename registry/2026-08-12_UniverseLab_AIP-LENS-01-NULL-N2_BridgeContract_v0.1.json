  "status": "BRIDGE_CONTRACT_DEFINED_EXECUTABLE_VALIDATION_ONLY_PHYSICAL_SIMULATOR_NOT_YET_VALIDATED_NO_REAL_DATA_EXECUTION",
  "purpose": "Define the physics and data-semantics bridge from cosmological parameters to KiDS-1000 fiducial COSEBIs without touching real KiDS measurements.",
  "observable_semantics": {
    "real_data_target": "KIDS1000_DR4_FIDUCIAL_COSEBIS",
    "simulation_output_required": "THE_SAME_COSEBIS_OBSERVABLE_VECTOR_SEMANTICS_AS_THE_FROZEN_REAL_DATA_CONTROL",
    "n1_toy_feature_reuse": "FORBIDDEN",
    "published_posterior_as_training_target": "FORBIDDEN"
  },
  "forward_chain": [
    {
      "stage": "COSMOLOGY_TO_MATTER_POWER",
      "input": ["Omega_m", "Omega_b", "h", "n_s", "amplitude_parameter", "neutrino_sector", "nuisance_configuration"],
      "output": "P_delta(k,z)",
      "requirement": "Use a declared physical matter-power implementation consistent with the frozen KiDS reference configuration; any emulator must be independently validated against its authoritative engine over the full training domain."
    },
    {
      "stage": "MATTER_POWER_TO_TOMOGRAPHIC_SHEAR_POWER",
      "input": ["P_delta(k,z)", "source_nz", "background_distances", "intrinsic_alignment_model", "baryonic_or_scale_policy"],
      "output": "C_ell_ij",
      "equation": "C_ell^{ij}=integral dchi [q_i(chi) q_j(chi)/chi^2] P_delta((ell+1/2)/chi,z(chi)) plus declared IA terms",
      "approximation": "Limber/extended-Limber choice must match the frozen reference implementation or be quantitatively cross-validated before authorization."
    },
    {
      "stage": "SHEAR_POWER_TO_CORRELATION_FUNCTIONS",
      "input": "C_ell_ij",
      "output": ["xi_plus_ij(theta)", "xi_minus_ij(theta)"],
      "equation": "xi_plus/minus(theta)=(1/2pi) integral d ell ell C_ell J_0/J_4(ell theta)",
      "requirement": "Angular conventions, theta units, binning and numerical quadrature must be frozen and regression-tested."
    },
    {
      "stage": "CORRELATION_FUNCTIONS_TO_COSEBIS",
      "input": ["xi_plus_ij(theta)", "xi_minus_ij(theta)", "COSEBI_filter_basis"],
      "output": ["E_n_ij", "B_n_ij"],
      "equation": "E_n=(1/2) integral_{theta_min}^{theta_max} dtheta theta [T_plus_n xi_plus + T_minus_n xi_minus]; B_n uses the corresponding sign change",
      "requirement": "Filter basis, theta interval, mode ordering and tomography ordering must be bitwise or numerically bound to the KiDS-1000 fiducial COSEBIs semantics before real-data execution."
    }
  ],
  "authoritative_reference_route": {
    "implementation_family": "KCAP/CosmoSIS configuration distributed with the KiDS-1000 cosmic-shear products",
    "role": "AUTHORITATIVE_REPRODUCTION_REFERENCE",
    "real_data_opened_in_this_bridge": false,
    "released_posterior_chains_opened_in_this_bridge": false,
    "exact_reference_configuration_values_frozen_here": false,
    "reason": "This bridge stage defines the interface and validation obligations only; exact released configuration files must be hashed and frozen in a later implementation freeze before physical validation."
  },
  "required_parameter_and_nuisance_binding": {
    "cosmology": ["Omega_m", "Omega_b", "h", "n_s", "amplitude_parameter", "neutrino_sector"],
    "survey_and_nuisance": [
      "source_redshift_distributions",
      "source_redshift_uncertainty",
      "multiplicative_shear_calibration",
      "intrinsic_alignments",
      "shape_noise_or_covariance_treatment",
      "baryonic_feedback_or_explicit_scale_policy",
      "survey_geometry_mask_or_reference_statistic_window"
    ],
    "rule": "The exact parameterization and priors must be copied from and hashed against the frozen reference configuration before any N2 execution authorization."
  },
  "simulation_training_contract": {
