  "background_contract": {
    "model": "lcdm",
    "equation": "E2(a)=Omega_r a^-4 + Omega_m a^-3 + Omega_k a^-2 + Omega_Lambda",
    "curvature": "Omega_k=1-Omega_r-Omega_m-Omega_Lambda",
    "reference_parameters": {
      "H0": 67.4,
      "Omega_m": 0.315,
      "Omega_r": 0.000092,
      "Omega_Lambda": 0.684908,
      "Omega_k": 0.0
    },
    "reference_density_slider_resolution": 0.000001,
    "visible_redshift_domain": "0<=z<=5",
    "scale_factor_preflight": "1e-8<=a<=1 logarithmic sampling",
    "invalid_policy": "FAIL_CLOSED_NO_POSITIVE_FLOOR",
    "invalid_code": "INVALID_BACKGROUND_DOMAIN",
    "time_variable": "tau=H0 t",
    "display_time_equation": "d ln(a)/d tau = E(a)",
    "display_time_integrator": "PRECOMPUTED_MONOTONE_SIMPSON_TAU_OF_LN_A_MAP",
    "display_time_map_points": 4096,
    "display_time_endpoint": "EXACT_X_0_A_1_Z_0",
    "endpoint_roundoff_policy": "PIN_FINAL_LOG_SCALE_FACTOR_NODE_TO_ZERO_WITHOUT_RELAXING_ENGINE_REDSHIFT_DOMAIN",
    "maximum_time_amplification": 100,
    "maximum_step_delta_tau": 0.002,
    "future_domain": "NOT_INCLUDED_A_GREATER_THAN_1"
  },
  "growth_contract": {
    "equation": "D''+[2+d ln H/d ln a]D'-(3/2)Omega_m(a)D=0",
    "derivative_variable": "ln a",
    "initial_condition": "matter-regime growing mode at a_i=max(1e-3,10 Omega_r/Omega_m)",
    "normalization": "D(1)=1",
    "displayed_exact_quantities": [
      "D(a)",
      "f(a)=d ln D/d ln a"
    ],
    "approximation": "Omega_m(a)^0.55",
    "approximation_role": "DISPLAY_ONLY_DIAGNOSTIC_NOT_DYNAMICS",
    "bridge_growth": "UNRELEASED_GROWTH_MAP"
  },
  "cellular_automaton_contract": {
    "rules": [
      "B3/S23",
      "B36/S23",
      "B2/S",
      "B3678/S34678"
    ],
    "boundary": "PERIODIC_TORUS",
