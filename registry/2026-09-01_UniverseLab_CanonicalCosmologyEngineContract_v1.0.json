      "growth": "released as standard linear GR smooth-DE reference"
    },
    "wcdm": {
      "E2": "Omega_r a^-4 + Omega_m a^-3 + Omega_k a^-2 + Omega_DE a^[-3(1+w)]",
      "growth": "released as linear GR smooth constant-w DE reference"
    },
    "bridge": {
      "Delta": "beta_tau I_B exp[-(a/a_c)^2]",
      "a_c": "Rchi/(Rchi+2.5)",
      "Rchi_domain": "Rchi > 0",
      "small_Rchi_asymptotic": "a_c = Rchi/2.5 + O(Rchi^2)",
      "hidden_Rchi_floor": false,
      "E2": "E_LCDM^2 (1 + Delta)",
      "growth": "UNRELEASED_GROWTH_MAP",
      "physical_parent_status": "OPEN"
    }
  },
  "distance_chain": {
    "D_H": "c/H0",
    "D_C": "D_H integral_0^z dz'/E(z')",
    "D_M_open": "D_H/sqrt(Omega_k) sinh[sqrt(Omega_k) D_C/D_H]",
    "D_M_flat": "D_C",
    "D_M_closed": "D_H/sqrt(|Omega_k|) sin[sqrt(|Omega_k|) D_C/D_H]",
    "D_L": "(1+z) D_M",
    "D_A": "D_M/(1+z)",
    "distance_modulus": "5 log10(D_L/Mpc) + 25",
    "etherington_ratio": "D_L/[(1+z)^2 D_A] = 1"
  },
  "growth_reference": {
    "equation": "D'' + [2 + d ln H/d ln a] D' - (3/2) Omega_m(a) D = 0",
    "derivative_variable": "ln a",
    "initial_condition": "D(a_i)=a_i and D'(a_i)=a_i",
    "default_a_i": "max(1e-3, 10 Omega_r/Omega_m)",
    "normalization": "D(1)=1",
    "solver": "fixed-step classical RK4 with an exact shortened final step",
    "default_steps": 4000,
    "endpoint": "EXACT_X_0_A_1",
    "endpoint_policy": "The final integration abscissa is constructed as x=0 and a=1; no tolerance relaxation of the public z>=0 domain is permitted.",
    "solution_metadata": {
      "api_version": "1.0.0",
      "implementation_revision": "1.0.2"
    },
    "scope": "linear pressureless matter perturbations in GR with smooth LCDM or constant-w dark energy",
    "excluded": [
      "bridge perturbations",
      "radiation perturbations",
      "massive-neutrino scale dependence",
      "nonlinear growth",
      "baryonic feedback",
      "modified-gravity mu or Sigma"
    ]
  },
  "fail_closed_domain_rules": {
