  "rr2_blocker_closure": {
    "RR2-B01": {
      "title": "IMMUTABLE_EXISTING_OUTPUT_PATH_CHECK_OCCURS_AFTER_SOLVER_EXECUTION",
      "status": "IMPLEMENTED_PENDING_RR3",
      "implementation": "The H2 transaction derives results/<grant_nonce> and all matching staging paths immediately after release/grant validation and external-root validation. Existing immutable result or stale staging paths abort before strict numerical-runtime validation, grant spend, backend import, child-process creation or solver initialization.",
      "abort_before_solver_initialization": true,
      "abort_before_grant_spend": true
    },
    "RR2-B02": {
      "title": "ONE_THREAD_RESOURCE_LIMIT_NOT_FAIL_CLOSED_BEFORE_BLAS_INITIALIZATION",
      "status": "IMPLEMENTED_PENDING_RR3",
      "implementation": "All five frozen numerical thread-control variables must equal exactly 1 and PYTHONHASHSEED must equal 0 before validate_runtime imports NumPy/SciPy. After import, the v1.3 supervisor positively queries the loaded OpenBLAS/MKL/BLIS runtime via exported thread-count symbols and fails closed unless every observed numerical thread pool reports exactly one thread; this occurs before grant spend.",
      "unset_thread_controls_allowed": false,
      "effective_pool_attestation_before_grant_spend": true
    },
    "RR2-B03": {
      "title": "TOTAL_WALL_CLOCK_LIMIT_NOT_CONTINUOUSLY_ENFORCED_DURING_TARGET_FINALIZATION",
      "status": "IMPLEMENTED_PENDING_RR3",
      "implementation": "The numerical target runs in a spawned child process retaining its preregistered per-entry SIGALRM timers. An independent parent-process ITIMER_REAL of 21600 seconds remains active continuously across child startup, all 35 schedule entries, target _finalize, the >=80-bit precision audit, result deserialization, schema packaging and atomic result-directory commit. The child is forcibly terminated in a finally block on timeout or parent interruption.",
      "maximum_wall_clock_seconds_total": 21600,
      "covers_target_finalize": true,
      "covers_precision_audit": true,
      "covers_packaging_and_atomic_commit": true
    },
    "RR2-B04": {
      "title": "PREREGISTERED_HIGH_PRECISION_BORDERLINE_AUDIT_PATH_ABSENT",
      "status": "IMPLEMENTED_PENDING_RR3",
      "implementation": "A conservative predeclared borderline policy treats every otherwise-passing N=96 candidate as requiring >=80-bit residual re-evaluation. The target reconstructs the regularized N=96 state and recomputes the primary bulk equations, all eight boundary residuals and propagated rr constraint using numpy.longdouble, with long-double Chebyshev nodes generated from long-double arccos(-1) rather than a binary64 pi seed. It requires at least a 64-bit significand (x87 80-bit extended or better). Missing precision, missing profile state, nonfinite values or threshold failure converts the candidate to NUMERICAL_ROOT_REJECTED_BY_QA fail-closed.",
      "borderline_policy": "ALL_OTHERWISE_PASSING_CANDIDATES",
      "post_hoc_band_selection": false,
      "minimum_significand_bits": 64,
      "audit_failure_can_accept_candidate": false
    }
