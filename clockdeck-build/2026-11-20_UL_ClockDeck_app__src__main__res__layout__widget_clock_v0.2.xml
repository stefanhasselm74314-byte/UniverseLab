<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_panel"
    android:paddingStart="5dp" android:paddingEnd="9dp"
    android:paddingTop="5dp" android:paddingBottom="5dp">

    <!-- Isolated square artwork; fitCenter preserves a circular dial. -->
    <ImageView android:id="@+id/widget_background"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.10"
        android:scaleType="fitCenter"
        android:adjustViewBounds="false"
        android:contentDescription="UniverseLab Uhrwerk" />

    <!-- This entire panel is independent of the dial's aspect ratio. -->
    <LinearLayout android:id="@+id/widget_information"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.00"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="3dp">
        <TextView android:id="@+id/widget_brand"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="UNIVERSELAB" android:textColor="#E4F3FF"
            android:textSize="10sp" android:textStyle="bold"
            android:singleLine="true" android:gravity="center" />
        <TextView android:id="@+id/widget_theme"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#7BCBEE" android:textSize="10sp"
            android:singleLine="true" android:gravity="center" />
        <TextClock android:id="@+id/widget_time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="HH:mm" android:format12Hour="h:mm"
            android:gravity="center" android:singleLine="true"
            android:textColor="#F3F8FF" android:textSize="30sp"
            android:textStyle="bold" />
        <TextClock android:id="@+id/widget_date"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="EEE, dd.MM." android:format12Hour="EEE, dd.MM."
            android:gravity="center" android:singleLine="true"
            android:textColor="#ACBED0" android:textSize="12sp" />
        <TextView android:id="@+id/widget_battery"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:gravity="center"
            android:textColor="#7DDEFF" android:textSize="11sp"
            android:singleLine="true" android:text="AKKU --%" />
    </LinearLayout>
</LinearLayout>
